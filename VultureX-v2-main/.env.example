# Database (Supabase)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# NextAuth
AUTH_SECRET=your-secret-here
AUTH_URL=http://localhost:3000

# Google OAuth (optional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# OpenAI (for PitchForge)
OPENAI_API_KEY=sk-...

# Resend (email)
RESEND_API_KEY=re_...

# Stripe (for verified metrics)
STRIPE_CLIENT_ID=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_CONNECT_URL=

# Admin provisioning — used only by `npm run db:seed:admin`, never by the app.
# Optional overrides; defaults to the address specified in the brief when unset.
ADMIN_EMAIL=
ADMIN_PASSWORD=
